<view class="sub-page">
  <scroll-view class="sub-scroll" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="sub-content has-action">
      <view class="blue-header plain-header">
        <view class="nav-row">
          <view class="nav-action" catchtap="goBack">‹</view>
          <view class="nav-title">服务意向</view>
          <view class="nav-action"></view>
        </view>
        <view class="intro-title">{{service.title}}</view>
        <view class="intro-sub">{{service.desc}}</view>
      </view>

      <view class="form-card">
        <view class="form-row">
          <view class="form-label">联系人</view>
          <input class="form-input" placeholder="请输入联系人" data-field="contact" value="{{form.contact}}" bindinput="handleInput" />
        </view>
        <view class="form-row">
          <view class="form-label">手机号</view>
          <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" data-field="phone" value="{{form.phone}}" bindinput="handleInput" />
        </view>
        <view class="form-row">
          <view class="form-label">企业名称</view>
          <input class="form-input" placeholder="请输入企业名称" data-field="companyName" value="{{form.companyName}}" bindinput="handleInput" />
        </view>
        <view class="form-row">
          <view class="form-label">预算范围</view>
          <input class="form-input" placeholder="例如 5000-10000元" data-field="budget" value="{{form.budget}}" bindinput="handleInput" />
        </view>
        <view class="form-row">
          <view class="form-label">期望时间</view>
          <view class="datetime-picker">
            <picker mode="date" value="{{form.needDate}}" start="{{today}}" end="{{latestDate}}" bindchange="changeNeedDate">
              <view class="picker-value {{form.needDate ? '' : 'picker-placeholder'}}">{{form.needDate || '选择日期'}} 〉</view>
            </picker>
            <picker mode="time" value="{{form.needClock}}" bindchange="changeNeedClock">
              <view class="picker-value {{form.needClock ? '' : 'picker-placeholder'}}">{{form.needClock || '选择时间'}} 〉</view>
            </picker>
          </view>
        </view>
        <view class="form-row form-textarea-row">
          <view class="form-label">需求说明</view>
          <textarea class="form-textarea" placeholder="请描述具体服务需求" data-field="content" value="{{form.content}}" bindinput="handleInput"></textarea>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="fixed-action">
    <view class="primary-button" bindtap="submitForm">提交意向</view>
  </view>
</view>
