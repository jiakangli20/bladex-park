.pass-page {
  height: 100vh;
  overflow: hidden;
  background: #eef6ff;
}

.pass-scroll {
  height: 100vh;
}

.pass-content {
  min-height: 100vh;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #3d82ff 0%, #82b6ff 30%, #eef6ff 78%, #ffffff 100%);
}

.pass-hero {
  position: relative;
  height: 350rpx;
  padding: calc(env(safe-area-inset-top) + 118rpx) 40rpx 0;
  overflow: hidden;
}

.pass-hero::before {
  content: "";
  position: absolute;
  left: -120rpx;
  top: -180rpx;
  width: 560rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.pass-copy {
  position: relative;
  z-index: 2;
  color: #ffffff;
}

.pass-title {
  font-size: 36rpx;
  line-height: 1.2;
}

.pass-subtitle {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
}

.pass-illustration {
  position: absolute;
  right: 24rpx;
  bottom: 14rpx;
  width: 260rpx;
  height: 210rpx;
}

.door-panel {
  position: absolute;
  right: 20rpx;
  top: 0;
  width: 160rpx;
  height: 176rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 16rpx;
  background: linear-gradient(145deg, rgba(96, 151, 255, 0.85), rgba(44, 103, 226, 0.9));
  transform: skewY(10deg);
}

.door-panel::before {
  content: "";
  position: absolute;
  left: 42rpx;
  top: 64rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 26rpx 0 14rpx rgba(255, 255, 255, 0.75);
}

.door-base {
  position: absolute;
  right: 82rpx;
  bottom: 0;
  width: 116rpx;
  height: 62rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 -20rpx 0 rgba(255, 255, 255, 0.42);
}

.phone-card {
  position: absolute;
  left: 12rpx;
  top: 34rpx;
  width: 44rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #66ffd3, #28d8a0);
  transform: rotate(-8deg);
}

.phone-card::after {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
}

.code-card {
  position: relative;
  z-index: 3;
  margin: -4rpx 18rpx 0;
  min-height: 522rpx;
  padding: 62rpx 34rpx 48rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(55, 111, 199, 0.12);
}

.tenant-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.tenant-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
}

.tenant-name {
  color: #172033;
  font-size: 30rpx;
}

.tenant-role {
  margin-top: 10rpx;
  color: #4e5a6e;
  font-size: 24rpx;
}

.qr-image {
  display: block;
  width: 456rpx;
  height: 456rpx;
  margin: 58rpx auto 0;
}

.expire-time {
  margin-top: 28rpx;
  color: #6f7886;
  font-size: 24rpx;
  text-align: center;
}

.refresh-button {
  width: 168rpx;
  height: 62rpx;
  margin: 68rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4e5a6e;
  font-size: 26rpx;
}
