.detail-card { margin-top: 24rpx; }
.cover { width: 100%; height: 300rpx; border-radius: 12rpx; }
.head, .log > view:first-child { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:20rpx; }
.line, .summary, .log { margin-top:16rpx; color:#667085; font-size:24rpx; line-height:1.6; }
.opinion { margin-top:18rpx; padding:18rpx; border-radius:10rpx; background:#fff4f2; color:#d92d20; font-size:24rpx; }
.log { padding-top:16rpx; border-top:1rpx solid #edf0f4; }
.fixed-action { position:fixed; left:0; right:0; bottom:0; padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background:#fff; }
.action-row { display:flex; gap:16rpx; }
.action-row > view { flex:1; }
.warning { background:#f79009; }
