.detail-hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  color: #ffffff;
}

.detail-image,
.detail-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-mask {
  background: linear-gradient(180deg, rgba(10, 24, 48, 0.36), rgba(10, 24, 48, 0.64));
}

.detail-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 24rpx) 30rpx 0;
}

.hero-copy {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 38rpx;
  z-index: 2;
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.25;
}

.hero-subline {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
}

.price-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -24rpx;
  position: relative;
  z-index: 3;
}

.price-main {
  color: #4e5a6e;
  font-size: 26rpx;
}

.price-main text {
  color: #f43b3f;
  font-size: 46rpx;
}

.detail-tags {
  margin-top: 24rpx;
}

.facility-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.facility-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f5f8fc;
  color: #4e5a6e;
  font-size: 25rpx;
}

.settle-button {
  background: #13b94b;
}
