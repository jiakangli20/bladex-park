.detail-page { background: #f3f6fb; }
.state-card { margin: 28rpx 30rpx 0; padding: 70rpx 30rpx; border-radius: 18rpx; background: #fff; color: #7d8796; text-align: center; }
.retry-button { width: 180rpx; margin: 24rpx auto 0; padding: 18rpx 0; border-radius: 999rpx; background: #eef4ff; color: #1f63f5; }
.summary-card { margin: 24rpx 30rpx 0; padding: 30rpx; border-radius: 20rpx; background: linear-gradient(135deg, #fff, #f1f6ff); box-shadow: 0 8rpx 20rpx rgba(38, 60, 92, .06); }
.summary-head, .summary-progress, .submission-head { display: flex; align-items: center; justify-content: space-between; }
.summary-head > text { color: #667085; font-size: 25rpx; }
.summary-amount { margin-top: 18rpx; color: #172033; font-size: 58rpx; font-weight: 700; }
.summary-progress { margin-top: 22rpx; color: #475467; font-size: 25rpx; }
.summary-deadline { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e9edf3; color: #7d8796; font-size: 24rpx; }
.section-name { margin-bottom: 24rpx; color: #172033; font-size: 30rpx; font-weight: 600; }
.detail-grid { display: flex; flex-wrap: wrap; gap: 24rpx 20rpx; }
.detail-grid view { width: calc(50% - 10rpx); }
.detail-grid text { display: block; color: #98a3b3; font-size: 23rpx; }
.detail-grid strong { display: block; margin-top: 9rpx; color: #30394a; font-size: 27rpx; font-weight: 500; word-break: break-all; }
.form-label { margin: 24rpx 0 12rpx; color: #5f6b7c; font-size: 25rpx; }
.amount-input { height: 82rpx; display: flex; align-items: center; gap: 10rpx; padding: 0 22rpx; border: 1rpx solid #dfe5ee; border-radius: 14rpx; }
.amount-input text { color: #172033; font-size: 30rpx; }
.amount-input input { flex: 1; height: 80rpx; font-size: 30rpx; }
.upload-box { height: 150rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #9bbcfb; border-radius: 16rpx; background: #f6f9ff; color: #1f63f5; font-size: 25rpx; }
.voucher-preview { display: flex; align-items: center; gap: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #f6f8fb; }
.voucher-preview image { width: 120rpx; height: 90rpx; border-radius: 10rpx; }
.voucher-preview text { flex: 1; color: #475467; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.form-tip { margin-top: 16rpx; color: #98a3b3; font-size: 22rpx; }
.submission-item { padding: 22rpx 0; border-top: 1rpx solid #edf0f4; }
.submission-item:first-of-type { border-top: 0; }
.submission-head > text { color: #172033; font-size: 29rpx; font-weight: 600; }
.submission-time { margin-top: 14rpx; color: #7d8796; font-size: 23rpx; }
.submission-link { margin-top: 14rpx; color: #1f63f5; font-size: 24rpx; }
.audit-opinion { margin-top: 14rpx; padding: 16rpx; border-radius: 10rpx; background: #fff4f2; color: #d92d20; font-size: 24rpx; line-height: 1.5; }
.empty-line { padding: 30rpx 0; color: #98a3b3; text-align: center; }
.fixed-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -6rpx 20rpx rgba(35,55,85,.08); }
.full-button { width: 100%; }
.is-disabled { opacity: .6; }
