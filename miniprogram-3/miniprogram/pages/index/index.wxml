<view class="page-shell home-page">
  <scroll-view class="home-scroll" scroll-y type="list" show-scrollbar="{{false}}">
    <view class="home-scroll-content">
      <view class="hero-panel">
        <view class="hero-top">
          <view class="hero-notice" bindtap="showAdminNotifications">
            <view class="hero-bell"></view>
            <view wx:if="{{noticeCount}}" class="hero-badge">{{noticeCount}}</view>
          </view>
        </view>
        <image class="hero-park" src="/assets/images/home-hero-park.png" mode="aspectFit"></image>
        <view class="hero-title">智慧园区</view>
        <view class="hero-subtitle">助力效率及营收双增长</view>
      </view>

      <view class="notice-strip" bindtap="showNotice">
        <view class="notice-mark">
          <text>通知</text>
          <text>公告</text>
        </view>
        <view class="notice-text">{{noticeTitle}}</view>
        <view class="notice-arrow">〉</view>
      </view>

      <swiper wx:if="{{homeBanners.length}}" class="home-banner" indicator-dots="{{homeBanners.length > 1}}" autoplay circular interval="4500">
        <block wx:for="{{homeBanners}}" wx:key="id">
          <swiper-item><image class="home-banner-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openBanner" binderror="handleBannerImageError"></image></swiper-item>
        </block>
      </swiper>

      <view class="feature-panel">
        <block wx:for="{{quickActionRows}}" wx:for-item="actionRow" wx:key="*this">
          <view class="feature-row">
            <block wx:for="{{actionRow}}" wx:for-item="action" wx:key="key">
              <view class="feature-item" data-key="{{action.key}}" bindtap="handleQuickAction">
                <view class="feature-icon feature-{{action.tone}}">
                  <image class="feature-image" src="/assets/icons/{{action.icon || action.key}}.png" mode="aspectFit"></image>
                </view>
                <text>{{action.label}}</text>
              </view>
            </block>
          </view>
        </block>
      </view>

      <view class="service-section">
        <view class="section-title">企业服务</view>
        <view class="service-grid">
          <block wx:for="{{homeServiceCards}}" wx:key="key">
            <view class="service-card service-{{item.tone}}" data-key="{{item.key}}" bindtap="openServiceCard">
              <view>
                <view class="service-title">{{item.title}}</view>
                <view class="service-desc">{{item.desc}}</view>
              </view>
              <view class="service-art">
                <view class="service-art-mask service-art-{{item.key}}"></view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="policy-section">
        <view class="section-head-line">
          <text>最新政策</text>
          <view bindtap="showPolicies">更多 〉</view>
        </view>
        <block wx:for="{{homePolicies}}" wx:key="id">
          <view class="policy-item" data-id="{{item.id}}" bindtap="openPolicy">
            <view class="policy-copy">
              <view class="policy-title">{{item.title}}</view>
              <view class="policy-time">{{item.time}}</view>
            </view>
            <image class="policy-image" src="{{item.image}}" mode="aspectFill"></image>
          </view>
        </block>
      </view>

      <view class="activity-section">
        <view class="section-head-line">
          <text>园区活动</text>
          <view bindtap="showActivities">更多 〉</view>
        </view>
        <block wx:for="{{homeActivities}}" wx:key="id">
          <view class="activity-item" data-id="{{item.id}}" bindtap="openActivity">
            <image class="activity-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="handleActivityImageError"></image>
            <view class="activity-copy">
              <view class="activity-title">{{item.title}}</view>
              <view class="activity-details">
                <view class="activity-meta"><text class="activity-meta-label">开始</text><text>{{item.startTimeText}}</text></view>
                <view class="activity-meta"><text class="activity-meta-label">结束</text><text>{{item.endTimeText}}</text></view>
                <view class="activity-meta"><text class="activity-meta-label">地点</text><text class="activity-meta-value">{{item.address || '待定'}}</text></view>
              </view>
              <view class="activity-foot">
                <text class="activity-price {{item.priceText === '免费' ? 'is-free' : 'is-paid'}}">{{item.priceText}}</text>
                <text class="activity-more">查看详情 〉</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <app-tab-bar active="home"></app-tab-bar>
</view>
