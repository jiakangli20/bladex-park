.home-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f5f7fb;
}

.home-scroll {
  height: 100vh;
}

.home-scroll-content {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.hero-panel {
  position: relative;
  height: 436rpx;
  padding: calc(env(safe-area-inset-top) + 34rpx) 30rpx 0;
  overflow: hidden;
  background: linear-gradient(135deg, #d8ecff 0%, #91ccff 100%);
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 150rpx;
}

.service-center {
  color: rgba(255, 255, 255, 0.96);
  font-size: 28rpx;
}

.hero-notice {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-bell {
  width: 30rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 7rpx 7rpx;
  position: relative;
}

.hero-bell::before {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  bottom: -5rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.hero-badge {
  position: absolute;
  right: -14rpx;
  top: -10rpx;
  min-width: 36rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ff5963;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.hero-park {
  position: absolute;
  right: -2rpx;
  bottom: 0;
  width: 478rpx;
  height: 284rpx;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 122rpx;
  color: #1460f6;
  font-size: 46rpx;
  line-height: 1.1;
}

.hero-subtitle {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: #3666a5;
  font-size: 28rpx;
}

.notice-strip {
  min-height: 110rpx;
  margin: 20rpx 18rpx 0;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.notice-mark {
  width: 72rpx;
  flex: none;
  color: #172033;
  font-size: 25rpx;
  line-height: 1.15;
}

.notice-mark text:first-child {
  display: block;
  color: #1767ff;
}

.notice-text {
  flex: 1;
  min-width: 0;
  color: #2f3745;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-arrow {
  color: #b8c0cc;
  font-size: 32rpx;
}

.feature-panel {
  display: block;
  margin: 20rpx 18rpx 0;
  padding: 30rpx 14rpx 22rpx;
  border: 1rpx solid #edf1f7;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.05);
}

.feature-row {
  width: 100%;
  display: flex;
  align-items: flex-start;
}

.feature-row + .feature-row {
  margin-top: 12rpx;
}

.feature-item {
  flex: 0 0 20%;
  width: 20%;
  max-width: 20%;
  box-sizing: border-box;
  min-width: 0;
  min-height: 122rpx;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 15rpx;
  color: #2f3745;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.feature-image {
  width: 40rpx;
  height: 40rpx;
}

.feature-mask {
  background: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.feature-blue {
  background: #e7f5ff;
  color: #2694ff;
}

.feature-sky {
  background: #e9f6ff;
  color: #35a7ff;
}

.feature-green {
  background: #e5fbf0;
  color: #21c77b;
}

.feature-orange,
.feature-amber {
  background: #fff1df;
  color: #ff9b3d;
}

.feature-cyan {
  background: #e8fbff;
  color: #19a9c7;
}

.feature-red {
  background: #ffefed;
  color: #ff5a54;
}

.feature-purple {
  background: #f1ebff;
  color: #8b5cf6;
}

.feature-gray {
  background: #f0f2f5;
  color: #8a96a8;
}

