.service-section,
.policy-section,
.activity-section {
  margin: 20rpx 18rpx 0;
  padding: 18rpx 20rpx 22rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 32rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.service-card {
  width: 48.6%;
  min-height: 108rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 14rpx;
  overflow: hidden;
}

.service-purple {
  background: linear-gradient(135deg, #eef0ff 0%, #f8f2ff 100%);
}

.service-orange {
  background: linear-gradient(135deg, #fff8e8 0%, #fff0d7 100%);
}

.service-cyan {
  background: linear-gradient(135deg, #e9fbff 0%, #d9f6f4 100%);
}

.service-pink {
  background: linear-gradient(135deg, #fff1f4 0%, #ffe9ee 100%);
}

.service-title {
  color: #172033;
  font-size: 25rpx;
  line-height: 1.2;
}

.service-desc {
  margin-top: 10rpx;
  color: #5f6b7c;
  font-size: 21rpx;
}

.service-art {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.service-purple .service-art {
  background: linear-gradient(135deg, #7d58ff, #b989ff);
}

.service-orange .service-art {
  background: linear-gradient(135deg, #ff8c32, #ffc065);
}

.service-cyan .service-art {
  background: linear-gradient(135deg, #4385ff, #7de6ff);
}

.service-pink .service-art {
  background: linear-gradient(135deg, #ff3f65, #ffadb9);
}

.service-art-mask {
  width: 34rpx;
  height: 34rpx;
  background: #ffffff;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.service-art-repair,
.service-art-venue {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='m21 6.5-4.2 4.2-3.5-3.5L17.5 3A6 6 0 0 0 10 10.5l-7 7L6.5 21l7-7A6 6 0 0 0 21 6.5'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='m21 6.5-4.2 4.2-3.5-3.5L17.5 3A6 6 0 0 0 10 10.5l-7 7L6.5 21l7-7A6 6 0 0 0 21 6.5'/%3E%3C/svg%3E");
}

.service-art-declare,
.service-art-ip {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M5 4h14v16H5zm4 4v2h6V8zm0 4v2h6v-2zm0 4v2h4v-2z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M5 4h14v16H5zm4 4v2h6V8zm0 4v2h6v-2zm0 4v2h4v-2z'/%3E%3C/svg%3E");
}

.section-head-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #172033;
  font-size: 31rpx;
}

.section-head-line view {
  color: #98a3b3;
  font-size: 24rpx;
}

.policy-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.policy-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.policy-copy {
  flex: 1;
  min-width: 0;
}

.policy-title {
  color: #172033;
  font-size: 27rpx;
  line-height: 1.45;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.policy-time {
  margin-top: 18rpx;
  color: #a3abb7;
  font-size: 23rpx;
}

.policy-image {
  width: 128rpx;
  height: 78rpx;
  flex: none;
  border-radius: 6rpx;
}

.activity-section {
  margin-bottom: 22rpx;
}

.activity-item {
  display: flex;
  gap: 22rpx;
  padding: 20rpx 0;
}

.activity-item + .activity-item {
  border-top: 1rpx solid #eef1f5;
}

.activity-image {
  width: 130rpx;
  height: 130rpx;
  flex: none;
  border-radius: 6rpx;
}

.activity-copy {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.activity-title {
  color: #172033;
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-meta,
.activity-address {
  margin-top: 6rpx;
  color: #7d8796;
  font-size: 22rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-address::before {
  content: "";
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #4e9cff;
}

.activity-price {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1;
}

.activity-price.is-free {
  color: #2f80ff;
}

.activity-price.is-paid {
  color: #ff3b30;
}
