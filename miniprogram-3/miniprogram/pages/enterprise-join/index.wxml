<view class="sub-page join-page">
  <scroll-view class="sub-scroll" scroll-y show-scrollbar="false">
    <view class="sub-content has-action">
      <view class="blue-header auth-header">
        <view class="nav-row"><view class="nav-action" catchtap="goBack">‹</view><view class="nav-title">申请成为企业员工</view><view class="nav-action"></view></view>
        <view class="privacy-tip">申请提交后，由对应企业园区管理员审核</view>
      </view>

      <view class="section-card form-section invite-section">
        <view class="card-title section-heading">企业信息</view>
        <view class="form-row">
          <view class="form-label required">企业邀请码</view>
          <input class="form-input" maxlength="32" placeholder="请输入邀请码" value="{{form.inviteCode}}" data-key="inviteCode" bindinput="input" bindblur="resolveInvite" />
          <view class="verify-action" bindtap="resolveInvite">{{resolving ? '校验中' : '校验'}}</view>
        </view>
        <view wx:if="{{inviteInfo}}" class="invite-result"><view class="result-name">{{inviteInfo.enterpriseName}}</view><view class="result-park">申请加入：{{inviteInfo.parkName}}</view></view>
        <view wx:else class="invite-tip">输入邀请码后可确认对应企业和园区</view>
      </view>

      <view class="section-card form-section basic-section">
        <view class="card-title section-heading">个人信息</view>
        <view class="form-row"><view class="form-label required">姓名</view><input class="form-input" placeholder="请输入姓名" value="{{form.name}}" data-key="name" bindinput="input" /></view>
        <view class="form-row"><view class="form-label required">手机号</view><input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.mobile}}" data-key="mobile" bindinput="input" /></view>
        <view class="form-row"><view class="form-label required">邮箱</view><input class="form-input" placeholder="请输入邮箱地址" value="{{form.email}}" data-key="email" bindinput="input" /></view>
        <view class="form-row"><view class="form-label required">证件类型</view><view class="form-value-area" bindtap="chooseIdType"><text class="form-placeholder {{form.idType ? 'has-value' : ''}}">{{form.idType || '请选择'}}</text><text class="row-arrow">›</text></view></view>
        <view class="form-row"><view class="form-label required">证件号码</view><input class="form-input" placeholder="请输入证件号码" value="{{form.idNo}}" data-key="idNo" bindinput="input" /></view>
        <view class="form-row"><view class="form-label required">出生日期</view><picker class="value-picker" mode="date" value="{{form.birthDate}}" bindchange="changeBirthDate"><view class="form-value-area"><text class="form-placeholder {{form.birthDate ? 'has-value' : ''}}">{{form.birthDate || '请选择'}}</text><text class="row-arrow">›</text></view></picker></view>
        <view class="form-row"><view class="form-label required">性别</view><view class="form-value-area" bindtap="chooseGender"><text class="form-placeholder {{form.gender ? 'has-value' : ''}}">{{form.gender || '请选择'}}</text><text class="row-arrow">›</text></view></view>
      </view>

      <view class="section-card record-section" wx:if="{{records.length}}">
        <view class="card-title section-heading">申请记录</view>
        <block wx:for="{{records}}" wx:key="id"><view class="record-row"><view class="record-main"><view class="record-name">{{item.enterpriseName}}</view><view class="record-meta">{{item.parkName}} · {{item.createTimeText}}</view><view wx:if="{{item.reviewRemark}}" class="record-remark">审核说明：{{item.reviewRemark}}</view></view><text class="status-pill {{item.statusClass}}">{{item.statusText}}</text></view></block>
      </view>
    </view>
  </scroll-view>
  <view class="fixed-action auth-action"><view class="primary-button" bindtap="submit">{{submitting ? '提交中...' : '提交申请'}}</view></view>
</view>
