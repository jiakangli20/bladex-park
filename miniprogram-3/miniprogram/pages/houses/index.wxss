.houses-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f3f6fb;
}

.houses-scroll {
  height: 100vh;
}

.houses-scroll-content {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.houses-header {
  padding-bottom: 26rpx;
}

.filter-mark {
  position: relative;
}

.filter-mark::before {
  content: "";
  width: 34rpx;
  height: 34rpx;
  background: #ffffff;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M3 4h18l-7 8v7l-4 2v-9z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M3 4h18l-7 8v7l-4 2v-9z'/%3E%3C/svg%3E");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.house-search-wrap {
  padding: 24rpx 30rpx 26rpx;
  background: #ffffff;
}

.filter-row {
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 136rpx;
}

.down-arrow {
  width: 18rpx;
  height: 18rpx;
  border-right: 4rpx solid #98a3b3;
  border-bottom: 4rpx solid #98a3b3;
  transform: rotate(45deg) translateY(-4rpx);
}

.mini-filter {
  width: 26rpx;
  height: 26rpx;
  background: #98a3b3;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M3 4h18l-7 8v7l-4 2v-9z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M3 4h18l-7 8v7l-4 2v-9z'/%3E%3C/svg%3E");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.house-list {
  padding: 24rpx 0 12rpx;
}

.house-card {
  margin-bottom: 28rpx;
}

.house-image {
  display: block;
  width: 100%;
  height: 306rpx;
}

.house-body {
  padding: 30rpx;
}

.house-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.house-title {
  flex: 1;
  color: #172033;
  font-size: 32rpx;
}

.house-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 34rpx;
  margin-top: 24rpx;
  color: #5f6b7c;
  font-size: 26rpx;
}

.house-meta text {
  min-width: 0;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.house-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  color: #4e5a6e;
  font-size: 26rpx;
  white-space: nowrap;
}

.price text {
  color: #f43b3f;
  font-size: 42rpx;
}
