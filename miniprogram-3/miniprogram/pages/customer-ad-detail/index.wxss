.state-card { margin: 24rpx 30rpx 0; padding: 70rpx 30rpx; border-radius: 18rpx; background: #fff; color: #7d8796; text-align: center; }
.retry-button { width: 180rpx; margin: 24rpx auto 0; padding: 18rpx 0; border-radius: 999rpx; background: #eef4ff; color: #1f63f5; }
.ad-card { margin: 24rpx 30rpx 0; overflow: hidden; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(38,60,92,.07); }
.ad-card > image { width: 100%; height: 300rpx; display: block; background: #e9edf4; }
.ad-info { padding: 26rpx; }
.ad-head { display: flex; align-items: center; gap: 18rpx; }
.ad-title { flex: 1; color: #172033; font-size: 32rpx; font-weight: 600; }
.ad-line { margin-top: 15rpx; color: #667085; font-size: 24rpx; }
.audit-opinion { margin-top: 20rpx; padding: 18rpx; border-radius: 12rpx; background: #fff4f2; color: #d92d20; font-size: 24rpx; line-height: 1.5; }
.section-name { margin-bottom: 20rpx; color: #172033; font-size: 30rpx; font-weight: 600; }
.detail-row { display: flex; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #edf0f4; }
.detail-row text { width: 150rpx; flex: none; color: #98a3b3; font-size: 24rpx; }
.detail-row strong { flex: 1; color: #30394a; font-size: 25rpx; font-weight: 400; word-break: break-all; }
.empty-line { padding: 30rpx 0; color: #98a3b3; text-align: center; }
.timeline-item { position: relative; display: flex; gap: 20rpx; padding: 0 0 28rpx; }
.timeline-item::after { content: ''; position: absolute; left: 9rpx; top: 24rpx; bottom: 0; width: 2rpx; background: #dfe7f5; }
.timeline-item:last-child::after { display: none; }
.timeline-dot { position: relative; z-index: 1; width: 20rpx; height: 20rpx; margin-top: 8rpx; flex: none; border: 5rpx solid #dce9ff; border-radius: 50%; background: #1f63f5; }
.timeline-body { flex: 1; min-width: 0; }
.timeline-head { display: flex; justify-content: space-between; gap: 16rpx; color: #30394a; font-size: 26rpx; }
.timeline-head text:last-child { color: #98a3b3; font-size: 22rpx; }
.timeline-meta { margin-top: 10rpx; color: #7d8796; font-size: 23rpx; }
.timeline-opinion { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: #f6f8fb; color: #5f6b7c; font-size: 23rpx; }
.fixed-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -6rpx 20rpx rgba(35,55,85,.08); }
.action-row { display: flex; gap: 16rpx; }
.action-row .primary-button, .action-row .secondary-button { flex: 1; }
.warning-button { background: #f79009; }
