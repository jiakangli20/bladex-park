.review-page{display:flex;flex-direction:column}.status-tabs{height:92rpx;display:flex;flex:none;padding:0 30rpx;background:#fff;border-bottom:1rpx solid #e8edf3}.status-tab{position:relative;flex:1;display:flex;align-items:center;justify-content:center;color:#778395;font-size:28rpx}.status-tab.active{color:#1f63f5;font-weight:600}.status-tab.active::after{content:'';position:absolute;bottom:0;width:52rpx;height:5rpx;border-radius:5rpx;background:#1f63f5}.review-scroll{flex:1;height:0}.review-list{padding:2rpx 0 30rpx}.review-card{margin:22rpx 30rpx 0;padding:28rpx;border-radius:16rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(35,55,85,.06)}.review-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.applicant-name{color:#202a3a;font-size:34rpx;font-weight:600}.company-line{margin-top:9rpx;color:#718096;font-size:24rpx}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx 20rpx;margin-top:28rpx;padding-top:26rpx;border-top:1rpx solid #edf0f4}.detail-grid text{color:#98a3b3;font-size:22rpx}.detail-grid view view{margin-top:7rpx;color:#374254;font-size:26rpx;word-break:break-all}.apply-time,.review-remark{margin-top:22rpx;color:#8591a2;font-size:24rpx;line-height:1.5}.review-remark{margin-top:10rpx;color:#66758a}.review-actions{display:flex;justify-content:flex-end;gap:18rpx;margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #edf0f4}.reject-button,.approve-button{width:150rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:8rpx;font-size:27rpx}.reject-button{border:1rpx solid #e5a0a5;color:#d85059}.approve-button{background:#1f63f5;color:#fff}.empty-state{padding:160rpx 30rpx;color:#98a3b3;font-size:28rpx;text-align:center}
