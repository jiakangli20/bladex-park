<view class="login-page">
  <view class="login-hero">
    <view class="hero-orb orb-one"></view>
    <view class="hero-orb orb-two"></view>
    <view class="park-mark">
      <view class="mark-building mark-left"></view>
      <view class="mark-building mark-center"></view>
      <view class="mark-building mark-right"></view>
    </view>
    <view class="hero-title">智慧园区</view>
    <view class="hero-sub">企业服务与园区运营移动工作台</view>
  </view>

  <view class="login-panel">
    <view class="panel-title">{{needBind ? '完善登录' : '欢迎登录'}}</view>
    <view class="panel-sub">{{needBind ? '授权微信手机号，完成账号登录' : '使用微信身份安全登录园区小程序'}}</view>

    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="agreement-check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>我已阅读并同意《用户协议》和《隐私保护指引》</text>
    </view>

    <button wx:if="{{!needBind}}" class="wechat-button" loading="{{loading}}" disabled="{{loading}}" bindtap="startLogin">
      微信一键登录
    </button>
    <button wx:else class="wechat-button" loading="{{loading}}" disabled="{{loading || !agreed}}" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
      授权手机号并登录
    </button>
    <button class="browse-button" disabled="{{loading}}" bindtap="browseFirst">先浏览</button>

    <view class="security-tip">登录后根据当前账号权限展示园区服务</view>
  </view>
</view>
