<view class="login-page">
  <view class="login-hero">
    <view class="hero-orb orb-one"></view>
    <view class="hero-orb orb-two"></view>
    <view class="park-mark">
      <view class="mark-building mark-left"></view>
      <view class="mark-building mark-center"></view>
      <view class="mark-building mark-right"></view>
    </view>
    <view class="hero-title">智慧园区</view>
    <view class="hero-sub">企业服务与园区运营移动工作台</view>
  </view>

  <view class="login-panel">
    <view class="panel-title">欢迎登录</view>
    <view class="panel-sub">授权手机号，快捷登录园区小程序</view>

    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="agreement-check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text>我已阅读并同意《用户协议》和《隐私保护指引》</text>
    </view>

    <button class="wechat-button" loading="{{loading}}" disabled="{{loading || !agreed}}" open-type="getPhoneNumber" bindgetphonenumber="quickLogin">
      手机号快捷登录
    </button>
    <button class="browse-button" disabled="{{loading}}" bindtap="browseFirst">先浏览</button>

    <view wx:if="{{mockLoginEnabled}}" class="mock-login-panel">
      <view class="mock-title">开发测试游客</view>
      <view class="mock-sub">仅开发环境使用，不调用微信手机号授权</view>
      <view class="mock-row"><input class="mock-input" type="number" maxlength="11" value="{{mockMobile}}" bindinput="inputMockMobile" /><view class="mock-button" bindtap="mockGuestLogin">登录</view></view>
    </view>

    <view class="security-tip">首次登录完成后将创建游客账号</view>
  </view>
</view>
