.mine-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f3f6fb;
}

.mine-scroll {
  height: 100vh;
}

.mine-scroll-content {
  min-height: 100%;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.mine-header {
  min-height: 344rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: calc(env(safe-area-inset-top) + 62rpx) 30rpx 54rpx;
  background: #1f63f5;
  color: #ffffff;
}

.company-avatar {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #1f63f5;
}

.company-building {
  width: 60rpx;
  height: 60rpx;
  background: currentColor;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M4 3h12v18H4zm3 4v3h6V7zm0 5v3h6v-3zm11-2h3v11h-3z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M4 3h12v18H4zm3 4v3h6V7zm0 5v3h6v-3zm11-2h3v11h-3z'/%3E%3C/svg%3E");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.company-copy {
  flex: 1;
  min-width: 0;
}

.company-name {
  font-size: 34rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-meta {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
}

.company-arrow {
  color: #ffffff;
  font-size: 64rpx;
}

.menu-card {
  margin: 48rpx 30rpx 0;
  padding: 20rpx 0;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.06);
}

.account-card {
  margin-top: 24rpx;
}

.logout-card {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 30rpx 24rpx;
  border: 1rpx solid #f3d9dc;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.04);
  color: #e45161;
  font-size: 29rpx;
}

.logout-card:active {
  background: #fff6f7;
}

.menu-row {
  min-height: 126rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 30rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

.menu-red {
  background: #ffeded;
  color: #f43b3f;
}

.menu-blue {
  background: #eaf3ff;
  color: #1f63f5;
}

.menu-green {
  background: #e9faef;
  color: #13b94b;
}

.menu-purple {
  background: #f3ebff;
  color: #7b3fe4;
}

.menu-cyan {
  background: #e8fbff;
  color: #18c8c8;
}

.menu-orange {
  background: #fff3df;
  color: #ff7a00;
}

.menu-gray {
  background: #f0f2f5;
  color: #5f6b7c;
}

.menu-mask {
  width: 36rpx;
  height: 36rpx;
  background: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.menu-mask-orders,
.menu-mask-contracts,
.menu-mask-payments {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M6 3h12v18H6zm3 4v2h6V7zm0 4v2h6v-2zm0 4v2h4v-2z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M6 3h12v18H6zm3 4v2h6V7zm0 4v2h6v-2zm0 4v2h4v-2z'/%3E%3C/svg%3E");
}

.menu-mask-company {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M4 3h12v18H4zm3 4v3h6V7zm0 5v3h6v-3zm11-2h3v11h-3z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M4 3h12v18H4zm3 4v3h6V7zm0 5v3h6v-3zm11-2h3v11h-3z'/%3E%3C/svg%3E");
}

.menu-mask-account {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M11 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m-7 9c0-3.4 3.1-6 7-6 1.1 0 2.1.2 3 .6V17h-3v3H4zm13-7h3v3h3v3h-3v3h-3v-3h-3v-3h3z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M11 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m-7 9c0-3.4 3.1-6 7-6 1.1 0 2.1.2 3 .6V17h-3v3H4zm13-7h3v3h3v3h-3v3h-3v-3h-3v-3h3z'/%3E%3C/svg%3E");
}

.menu-mask-contact {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M12 3a7 7 0 0 0-7 7v4a3 3 0 0 0 3 3h1v-6H7v-1a5 5 0 0 1 10 0v1h-2v6h1a3 3 0 0 0 3-3v-4a7 7 0 0 0-7-7m-1 16h3v2h-3z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M12 3a7 7 0 0 0-7 7v4a3 3 0 0 0 3 3h1v-6H7v-1a5 5 0 0 1 10 0v1h-2v6h1a3 3 0 0 0 3-3v-4a7 7 0 0 0-7-7m-1 16h3v2h-3z'/%3E%3C/svg%3E");
}

.menu-mask-enterprise-certification,
.menu-mask-enterprise-join-review,
.menu-mask-enterprise-park-application {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M5 3h14v18H5zm3 4v2h8V7zm0 4v2h8v-2zm0 4v2h5v-2z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M5 3h14v18H5zm3 4v2h8V7zm0 4v2h8v-2zm0 4v2h5v-2z'/%3E%3C/svg%3E");
}

.menu-mask-enterprise-join,
.menu-mask-enterprise-invite {
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m-7 10c0-4 3-7 7-7 1.7 0 3.2.5 4.4 1.5A5 5 0 0 0 13 17c0 1.6.8 3.1 2 4zm16-8h2v3h3v2h-3v3h-2v-3h-3v-2h3z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='black' d='M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m-7 10c0-4 3-7 7-7 1.7 0 3.2.5 4.4 1.5A5 5 0 0 0 13 17c0 1.6.8 3.1 2 4zm16-8h2v3h3v2h-3v3h-2v-3h-3v-2h3z'/%3E%3C/svg%3E");
}

.menu-label {
  flex: 1;
  color: #172033;
  font-size: 30rpx;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f43b3f;
  color: #ffffff;
  font-size: 22rpx;
}

.menu-arrow {
  color: #98a3b3;
  font-size: 52rpx;
  line-height: 1;
}
