.picker-row { display: flex; gap: 16rpx; }
.picker-row picker { flex: 1; }
.picker-value { padding: 20rpx; border: 1rpx solid #e1e7ef; border-radius: 10rpx; color: #566377; font-size: 25rpx; }
.cover-box image { width: 100%; height: 300rpx; border-radius: 12rpx; }
.cover-box view { margin-top: 10rpx; color: #1f63f5; font-size: 23rpx; }
.upload-cover { height: 220rpx; display: flex; align-items: center; justify-content: center; border: 1rpx dashed #9cb8e8; border-radius: 12rpx; color: #1f63f5; }
