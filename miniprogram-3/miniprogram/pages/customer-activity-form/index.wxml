<!-- 园区活动申请表单 -->
<view class="sub-page activity-form-page"><scroll-view class="sub-scroll" scroll-y type="list" show-scrollbar="{{false}}"><view class="sub-content has-action"><view class="blue-header plain-header"><view class="nav-row"><view class="nav-action" bindtap="goBack">‹</view><view class="nav-title">{{title}}</view><view class="nav-action"></view></view><view class="intro-title">活动申请资料</view><view class="intro-sub">保存草稿后，在详情页提交园区审核</view></view><view class="form-card">
  <view class="form-label">活动标题 *</view><input class="form-input" maxlength="200" data-field="title" value="{{form.title}}" placeholder="请输入活动标题" bindinput="handleInput" />
  <view class="form-label">活动封面 *</view><view wx:if="{{form.coverUrl}}" class="cover-box" bindtap="chooseCover"><image src="{{form.coverUrl}}" mode="aspectFill"></image><view>点击更换封面</view></view><view wx:else class="upload-cover" bindtap="chooseCover">{{uploading ? '上传中...' : '+ 上传活动封面'}}</view>
  <view class="form-label">活动简介 *</view><textarea class="form-textarea" maxlength="1000" data-field="summary" value="{{form.summary}}" placeholder="请输入活动内容与参与说明" bindinput="handleInput"></textarea>
  <view class="form-label">开始时间 *</view><view class="picker-row"><picker mode="date" start="{{today}}" value="{{form.startDate}}" data-field="startDate" bindchange="changePicker"><view class="picker-value">{{form.startDate || '选择日期'}} 〉</view></picker><picker mode="time" value="{{form.startClock}}" data-field="startClock" bindchange="changePicker"><view class="picker-value">{{form.startClock || '选择时间'}} 〉</view></picker></view>
  <view class="form-label">结束时间 *</view><view class="picker-row"><picker mode="date" start="{{today}}" value="{{form.endDate}}" data-field="endDate" bindchange="changePicker"><view class="picker-value">{{form.endDate || '选择日期'}} 〉</view></picker><picker mode="time" value="{{form.endClock}}" data-field="endClock" bindchange="changePicker"><view class="picker-value">{{form.endClock || '选择时间'}} 〉</view></picker></view>
  <view class="form-label">活动地点 *</view><input class="form-input" maxlength="500" data-field="address" value="{{form.address}}" placeholder="请输入活动地点" bindinput="handleInput" />
  <view class="form-label">费用说明</view><input class="form-input" maxlength="100" data-field="priceText" value="{{form.priceText}}" placeholder="如：免费、99元/人" bindinput="handleInput" />
  <view class="form-label">联系人 *</view><input class="form-input" maxlength="30" data-field="contactName" value="{{form.contactName}}" placeholder="请输入联系人" bindinput="handleInput" />
  <view class="form-label">联系电话 *</view><input class="form-input" type="number" maxlength="11" data-field="contactPhone" value="{{form.contactPhone}}" placeholder="请输入联系电话" bindinput="handleInput" />
</view></view></scroll-view><view class="fixed-action"><view class="primary-button full-button {{saving ? 'is-disabled' : ''}}" bindtap="submitForm">{{saving ? '保存中...' : '保存草稿'}}</view></view></view>
