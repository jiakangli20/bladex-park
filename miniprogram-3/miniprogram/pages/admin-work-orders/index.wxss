.admin-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 30rpx 0;
}

.admin-tab {
  flex: 0 0 calc(50% - 8rpx);
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5f6b7c;
  font-size: 26rpx;
}

.admin-tab.is-active {
  background: #1f63f5;
  color: #ffffff;
}

.status-scroll {
  width: 100%;
  height: 88rpx;
  margin-top: 18rpx;
  white-space: nowrap;
}

.status-list {
  min-width: 100%;
  height: 88rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 30rpx 8rpx;
}

.status-chip {
  flex: none;
  height: 62rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5f6b7c;
  font-size: 25rpx;
}

.status-chip.is-active {
  background: #eaf3ff;
  color: #1f63f5;
}

.admin-order-list {
  padding: 2rpx 0 20rpx;
}

.admin-order-card {
  margin-top: 18rpx;
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.order-head .status-pill {
  flex: none;
  margin-top: 2rpx;
}
