.list-block {
  padding-bottom: 20rpx;
}

.list-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.account-block { padding-bottom: 24rpx; }
.member-section { margin-top: 20rpx; }
.member-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf1f6; }
.member-row:last-child { border-bottom: 0; }
.member-avatar { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 14rpx; background: #eaf3ff; color: #1f63f5; font-size: 28rpx; }
.member-main { flex: 1; min-width: 0; color: #263247; font-size: 26rpx; }
.member-main text { display: block; margin-top: 8rpx; color: #8290a3; font-size: 22rpx; }
.member-side { flex: none; color: #6d7b8f; font-size: 22rpx; text-align: right; }
.disable-link { margin-top: 10rpx; color: #dc5661; }
.account-empty { padding: 28rpx 0 10rpx; color: #909bad; font-size: 24rpx; text-align: center; }
