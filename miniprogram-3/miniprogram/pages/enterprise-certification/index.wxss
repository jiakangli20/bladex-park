.auth-page {
  background: #f3f6fb;
}

.auth-header {
  padding-bottom: 26rpx;
  background: linear-gradient(180deg, #3479ee 0%, #397cf0 72%, #eaf2ff 100%);
}

.privacy-tip {
  margin: 22rpx 18rpx 0;
  padding: 18rpx 28rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #e8f2ff;
  color: #4c82d5;
  font-size: 28rpx;
}

.form-section {
  margin-top: 18rpx;
  padding: 30rpx 34rpx 8rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(44, 77, 125, 0.06);
}

.first-section {
  margin-top: 0;
  border-radius: 0 0 20rpx 20rpx;
}

.section-heading {
  margin-bottom: 22rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.form-row {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 100rpx;
  border-bottom: 1rpx solid #e9edf3;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  flex: 0 0 250rpx;
  width: 250rpx;
  color: #202735;
  font-size: 28rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.form-label.required::before {
  position: absolute;
  top: 50%;
  left: 0;
  color: #ef5963;
  line-height: 1;
  transform: translateY(-50%);
  content: '*';
}

.form-label.required {
  position: relative;
  padding-left: 18rpx;
}

.form-input {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 88rpx;
  padding: 0;
  color: #232b3a;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: left;
}

.form-input::placeholder {
  color: #b7bdc7;
}

.type-row {
  min-height: 112rpx;
}

.type-switch {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  height: 64rpx;
  padding: 4rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 12rpx;
  background: #f3f5f8;
}

.type-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #6c7584;
  font-size: 27rpx;
}

.type-option.active {
  background: #2f78ee;
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(47, 120, 238, 0.2);
}

.form-value-area {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.form-placeholder {
  overflow: hidden;
  color: #b7bdc7;
  font-size: 28rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-placeholder.has-value {
  color: #344052;
}

.row-arrow {
  flex: none;
  margin-left: 16rpx;
  color: #8a95a5;
  font-size: 42rpx;
  line-height: 1;
}

.park-picker {
  padding: 10rpx 0 24rpx;
}

.park-picker-title {
  padding: 16rpx 0;
  color: #667085;
  font-size: 25rpx;
}

.park-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.park-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx 22rpx;
  border: 1rpx solid #d9dee7;
  border-radius: 10rpx;
  background: #fafbfc;
  color: #667085;
  font-size: 27rpx;
}

.park-option.selected {
  border-color: #3278ee;
  background: #eef5ff;
  color: #3278ee;
}

.check-mark {
  font-size: 25rpx;
}

.park-picker-done {
  margin-top: 20rpx;
  color: #3278ee;
  font-size: 28rpx;
  text-align: center;
}

.record-section {
  margin-top: 18rpx;
  border-radius: 20rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0f4;
  color: #3a4351;
  font-size: 28rpx;
}

.record-row:last-child {
  border-bottom: 0;
}

.status {
  color: #4b86df;
  font-size: 25rpx;
}

.status.APPROVED {
  color: #22a06b;
}

.status.REJECTED {
  color: #e76b71;
}

.auth-action {
  padding: 18rpx 48rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
}

.auth-action .primary-button {
  width: 100%;
  height: 82rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #3498f5, #2680ec);
  box-shadow: 0 6rpx 12rpx rgba(37, 126, 239, 0.22);
  font-size: 31rpx;
}

.auth-action .primary-button.disabled {
  opacity: 0.65;
}
