.utility-page { background: #f3f6fb; }
.bill-tabs { display: flex; gap: 14rpx; padding: 24rpx 30rpx 4rpx; }
.bill-tab { flex: 1; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #fff; color: #667085; font-size: 26rpx; }
.bill-tab.is-active { background: #1f63f5; color: #fff; box-shadow: 0 8rpx 18rpx rgba(31, 99, 245, .2); }
.state-card { margin: 28rpx 30rpx 0; padding: 70rpx 30rpx; border-radius: 18rpx; background: #fff; color: #7d8796; text-align: center; font-size: 27rpx; }
.retry-button { width: 180rpx; height: 66rpx; margin: 24rpx auto 0; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #eef4ff; color: #1f63f5; }
.bill-list { padding-bottom: 24rpx; }
.bill-card { margin: 24rpx 30rpx 0; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(38, 60, 92, .06); }
.bill-head { display: flex; align-items: center; gap: 18rpx; }
.bill-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 20rpx; color: #fff; font-size: 30rpx; font-weight: 600; }
.bill-icon-water { background: linear-gradient(135deg, #2ca7ff, #62d8ff); }
.bill-icon-electric { background: linear-gradient(135deg, #ff9b32, #ffc75f); }
.bill-title-wrap { flex: 1; min-width: 0; }
.bill-title { color: #172033; font-size: 31rpx; font-weight: 600; }
.bill-room { margin-top: 8rpx; color: #7d8796; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bill-period { margin-top: 22rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #f6f8fb; color: #5f6b7c; font-size: 25rpx; }
.amount-row { display: flex; justify-content: space-between; margin-top: 24rpx; }
.amount-row view { width: 31%; }
.amount-row text { display: block; color: #98a3b3; font-size: 22rpx; }
.amount-row strong { display: block; margin-top: 8rpx; color: #263245; font-size: 28rpx; }
.amount-row .is-danger { color: #f04438; }
.bill-foot { display: flex; justify-content: space-between; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f4; color: #7d8796; font-size: 23rpx; }
