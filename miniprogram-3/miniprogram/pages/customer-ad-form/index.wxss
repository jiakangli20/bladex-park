.form-card { margin: 24rpx 30rpx 0; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(38,60,92,.06); }
.form-label { margin: 26rpx 0 12rpx; color: #475467; font-size: 25rpx; }
.form-label:first-child { margin-top: 0; }
.form-input, .picker-value { width: 100%; height: 80rpx; padding: 0 22rpx; border: 1rpx solid #dfe5ee; border-radius: 14rpx; background: #fff; color: #172033; font-size: 27rpx; line-height: 80rpx; }
.picker-row { display: flex; gap: 16rpx; }
.picker-row picker { flex: 1; min-width: 0; }
.form-textarea { width: 100%; height: 180rpx; padding: 20rpx 22rpx; border: 1rpx solid #dfe5ee; border-radius: 14rpx; font-size: 27rpx; }
.upload-cover { height: 240rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #9bbcfb; border-radius: 16rpx; background: #f6f9ff; color: #1f63f5; }
.cover-box { overflow: hidden; border-radius: 16rpx; background: #f6f8fb; }
.cover-box image { width: 100%; height: 250rpx; display: block; }
.cover-box view { padding: 16rpx; color: #1f63f5; text-align: center; font-size: 24rpx; }
.fixed-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -6rpx 20rpx rgba(35,55,85,.08); }
.full-button { width: 100%; }
.is-disabled { opacity: .6; }
