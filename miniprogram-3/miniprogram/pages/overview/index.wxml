<view class="overview-page">
  <scroll-view class="overview-scroll" scroll-y type="list" show-scrollbar="{{false}}" refresher-enabled="{{true}}" bindrefresherrefresh="onPullDownRefresh">
    <view class="overview-content">
      <view class="hero">
        <view class="hero-glow hero-glow-one"></view>
        <view class="hero-glow hero-glow-two"></view>
        <view class="nav-row">
          <view class="nav-action nav-back" catchtap="goBack">‹</view>
          <view class="nav-title">园区概览</view>
          <view class="nav-action nav-more">···</view>
        </view>
        <view class="hero-main">
          <view>
            <view class="hero-eyebrow">PARK OPERATIONS</view>
            <view class="overview-title">园区运营驾驶舱</view>
            <view class="overview-sub">实时掌握园区经营与租客动态</view>
          </view>
          <view class="hero-status"><view class="status-dot"></view>运行正常</view>
        </view>
        <view class="hero-foot">
          <view>今日运行数据</view>
          <view>更新至 {{lastUpdated}}</view>
        </view>
      </view>

      <view class="demo-tip" wx:if="{{usingDemo}}"><view class="demo-dot"></view>当前为演示数据，接入接口后自动替换</view>

      <view class="metric-grid">
        <block wx:for="{{metrics}}" wx:key="label">
          <view class="metric-card metric-{{item.tone}}">
            <view class="metric-top"><view class="metric-icon">{{item.icon}}</view><view class="metric-trend" wx:if="{{item.trend}}">{{item.trend}}</view></view>
            <view class="metric-value">{{item.value}}<text>{{item.unit}}</text></view>
            <view class="metric-label">{{item.label}}</view>
          </view>
        </block>
      </view>

      <view class="section-block">
        <view class="section-heading"><view><view class="section-kicker">OPERATING SNAPSHOT</view><view class="section-title">经营概况</view></view><view class="section-link">本月</view></view>
        <view class="snapshot-grid">
          <view class="snapshot-card occupancy-card">
            <view class="snapshot-card-head"><view><view class="snapshot-label">出租率</view><view class="snapshot-value">{{progress.rentRate}}<text>%</text></view></view><view class="ring ring-blue"><view><text>{{progress.rentRate}}</text><text>%</text></view></view></view>
            <view class="snapshot-caption">已出租 {{progress.rentedArea}} · 总面积 {{progress.totalArea}}</view>
            <view class="progress-track"><view class="progress-fill rent-fill" style="width: {{progress.rentRate}}%;"></view></view>
          </view>
          <view class="snapshot-card collection-card">
            <view class="snapshot-card-head"><view><view class="snapshot-label">本月收缴率</view><view class="snapshot-value collection-value">{{progress.collectionRate}}<text>%</text></view></view><view class="ring ring-green"><view><text>{{progress.collectionRate}}</text><text>%</text></view></view></view>
            <view class="snapshot-caption">已收 {{progress.monthReceived}} · 应收 {{progress.monthReceivable}}</view>
            <view class="progress-track"><view class="progress-fill collection-fill" style="width: {{progress.collectionRate}}%;"></view></view>
          </view>
        </view>
      </view>

      <view class="section-block trend-todo-section">
        <view class="trend-card">
          <view class="section-heading compact"><view><view class="section-kicker">REVENUE TREND</view><view class="section-title">收入趋势</view></view><view class="trend-legend"><view></view>近6个月</view></view>
          <view class="chart"><view class="chart-grid"><view></view><view></view><view></view></view><view class="chart-bars"><block wx:for="{{trend}}" wx:key="month"><view class="bar-item"><view class="bar-value">{{item.value}}</view><view class="bar" style="height: {{item.height}}%;"></view><view class="bar-label">{{item.month}}</view></view></block></view></view>
        </view>
        <view class="todo-panel">
          <view class="section-heading compact"><view><view class="section-kicker">TASK CENTER</view><view class="section-title">待办中心</view></view><view class="todo-total">{{todoTotal}} 项</view></view>
          <block wx:for="{{todos}}" wx:key="label"><view class="todo-item" data-label="{{item.label}}" bindtap="openTodo"><view class="todo-icon todo-icon-{{item.tone}}">{{item.icon}}</view><view class="todo-copy"><view>{{item.label}}</view><text>{{item.desc}}</text></view><view class="todo-count todo-count-{{item.tone}}">{{item.count}}</view><view class="todo-arrow">›</view></view></block>
        </view>
      </view>

      <view class="section-block tenant-section">
        <view class="section-heading"><view><view class="section-kicker">TENANT PORTFOLIO</view><view class="section-title">租客企业</view></view><view class="section-link" bindtap="openTenants">全部 {{tenantCount}}</view></view>
        <view class="tenant-summary"><view><text>重点行业</text><view>{{topIndustry}}</view></view><view><text>正常履约</text><view>{{normalTenantCount}} 家</view></view><view><text>需关注</text><view class="warn-text">{{warningTenantCount}} 家</view></view></view>
        <block wx:for="{{tenants}}" wx:key="id"><view class="tenant-card" data-id="{{item.id}}" bindtap="openTenant"><view class="tenant-avatar tenant-avatar-{{item.tone}}">{{item.shortName}}</view><view class="tenant-main"><view class="tenant-name">{{item.companyName}}</view><view class="tenant-meta">{{item.industry}} <text>·</text> {{item.room}}</view><view class="tenant-meter"><view class="tenant-meter-fill" style="width: {{item.occupancy}}%;"></view></view><view class="tenant-meter-label">租赁面积 {{item.area}} <text>·</text> 合同至 {{item.leaseEnd}}</view></view><view class="tenant-side"><view class="tenant-status {{item.rentStatus === '正常' ? 'is-normal' : 'is-warn'}}">{{item.rentStatus}}</view><view class="tenant-arrow">›</view></view></view></block>
        <view class="empty-state" wx:if="{{!tenants.length}}"><view class="empty-icon">⌂</view><view>暂无租客数据</view><text>接入园区数据后将在这里展示</text></view>
      </view>
      <view class="page-foot">园区运营数据中心 · {{lastUpdated}}</view>
    </view>
  </scroll-view>
</view>
