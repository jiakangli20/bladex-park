.overview-page {
  height: 100vh;
  overflow: hidden;
  background: #f3f6fb;
  color: #172033;
}

.overview-scroll {
  height: 100vh;
}

.overview-content {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.overview-header {
  padding: calc(env(safe-area-inset-top) + 26rpx) 30rpx 40rpx;
  background: #165dff;
  color: #ffffff;
}

.overview-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  line-height: 1.2;
}

.overview-sub {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: -22rpx 30rpx 0;
}

.metric-card {
  width: calc(50% - 9rpx);
  min-height: 136rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.08);
}

.metric-blue {
  color: #165dff;
}

.metric-green {
  color: #13b94b;
}

.metric-orange {
  color: #ff7a00;
}

.metric-red {
  color: #fa3f46;
}

.metric-value {
  font-size: 42rpx;
  line-height: 1;
  white-space: nowrap;
}

.metric-value text {
  margin-left: 6rpx;
  font-size: 22rpx;
}

.metric-label {
  margin-top: 18rpx;
  color: #5f6b7c;
  font-size: 25rpx;
}

.section-block {
  margin: 36rpx 30rpx 0;
}

.section-title {
  margin-bottom: 20rpx;
  color: #172033;
  font-size: 32rpx;
}

.overview-card,
.tenant-card {
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.06);
}

.overview-card {
  padding: 28rpx;
}

.progress-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.progress-row text {
  color: #165dff;
  font-size: 30rpx;
  white-space: nowrap;
}

.progress-label {
  color: #8b96a5;
  font-size: 24rpx;
}

.progress-value {
  margin-top: 8rpx;
  color: #172033;
  font-size: 28rpx;
}

.progress-track {
  height: 16rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #edf1f6;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.rent-fill {
  background: #165dff;
}

.collection-fill {
  background: #13b94b;
}

.second-row {
  margin-top: 30rpx;
}

.todo-row {
  display: flex;
  gap: 16rpx;
}

.todo-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(35, 55, 85, 0.06);
}

.todo-green {
  color: #13b94b;
}

.todo-orange {
  color: #ff7a00;
}

.todo-red {
  color: #fa3f46;
}

.todo-count {
  font-size: 36rpx;
  line-height: 1;
  text-align: center;
}

.todo-label {
  margin-top: 12rpx;
  color: #5f6b7c;
  font-size: 23rpx;
  text-align: center;
  white-space: nowrap;
}

.tenant-section {
  margin-bottom: 30rpx;
}

.tenant-card {
  padding: 28rpx 28rpx 34rpx;
  margin-bottom: 30rpx;
}

.tenant-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.tenant-name {
  color: #172033;
  font-size: 30rpx;
  line-height: 1.25;
}

.tenant-industry {
  margin-top: 10rpx;
  color: #8b96a5;
  font-size: 24rpx;
}

.tenant-status {
  min-width: 76rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 23rpx;
  white-space: nowrap;
}

.tenant-status.is-normal {
  background: #e9faef;
  color: #13b94b;
}

.tenant-status.is-warn {
  background: #fff3df;
  color: #ff7a00;
}

.tenant-info {
  margin-top: 26rpx;
}

.tenant-room-line,
.tenant-period-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f6f8fb;
}

.tenant-period-line {
  margin-top: 18rpx;
}

.tenant-info-row {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.tenant-info-item {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f6f8fb;
}

.tenant-info text {
  display: block;
  flex: none;
  color: #98a3b3;
  font-size: 22rpx;
  line-height: 1.3;
}

.tenant-room-line view,
.tenant-period-line view,
.tenant-info-item view {
  min-width: 0;
  color: #4e5a6e;
  font-size: 25rpx;
  line-height: 1.28;
  word-break: break-all;
}

.tenant-room-line view,
.tenant-period-line view {
  flex: 1;
  text-align: right;
}

.tenant-info-item view {
  margin-top: 8rpx;
}
