.mall-page {
  height: 100vh;
  overflow: hidden;
  background: #f3f6fb;
  color: #17243a;
}

.mall-scroll {
  height: 100vh;
}

.mall-content {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.mall-hero {
  position: relative;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 22rpx) 32rpx 46rpx;
  background: linear-gradient(140deg, #125bd4 0%, #2778f5 56%, #1cae9b 100%);
  color: #fff;
}

.mall-orbit {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  pointer-events: none;
}

.mall-orbit-one {
  width: 360rpx;
  height: 360rpx;
  right: -170rpx;
  top: -170rpx;
}

.mall-orbit-two {
  width: 190rpx;
  height: 190rpx;
  right: 62rpx;
  bottom: -130rpx;
  border-color: rgba(255, 255, 255, 0.22);
}

.mall-hero .nav-row {
  position: relative;
  z-index: 1;
}

.mall-back {
  font-family: Arial, sans-serif;
  font-size: 50rpx;
  font-weight: 200;
}

.mall-more {
  font-size: 29rpx;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.16);
}

.mall-kicker {
  position: relative;
  z-index: 1;
  margin-top: 42rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.mall-title {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 650;
}

.mall-subtitle {
  position: relative;
  z-index: 1;
  max-width: 600rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  line-height: 1.45;
}

.mall-status-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: -20rpx 30rpx 0;
  padding: 24rpx 22rpx;
  position: relative;
  z-index: 2;
  border: 1rpx solid #e7edf6;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(27, 56, 99, 0.08);
}

.mall-status-icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 20rpx;
  background: #eaf2ff;
  color: #246dff;
  font-size: 30rpx;
}

.mall-status-copy {
  min-width: 0;
  flex: 1;
}

.mall-status-title {
  color: #21334f;
  font-size: 28rpx;
  font-weight: 600;
}

.mall-status-desc {
  margin-top: 7rpx;
  overflow: hidden;
  color: #92a0b4;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mall-status-tag {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fff4e3;
  color: #d8891c;
  font-size: 19rpx;
}

.mall-section {
  margin: 38rpx 30rpx 0;
}

.mall-section-kicker {
  color: #9aa8bc;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.mall-section-title {
  margin-top: 8rpx;
  color: #17243a;
  font-size: 32rpx;
  font-weight: 650;
}

.mall-feature-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.mall-feature {
  min-width: 0;
  flex: 1;
  padding: 20rpx 16rpx;
  border: 1rpx solid #e7edf6;
  border-radius: 18rpx;
  background: #fff;
}

.mall-feature-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.mall-feature-orange .mall-feature-icon {
  background: #fff3df;
  color: #e18b20;
}

.mall-feature-blue .mall-feature-icon {
  background: #edf3ff;
  color: #246dff;
}

.mall-feature-green .mall-feature-icon {
  background: #e8f9f0;
  color: #12a866;
}

.mall-feature-title {
  margin-top: 16rpx;
  color: #30415c;
  font-size: 24rpx;
  font-weight: 600;
}

.mall-feature-desc {
  margin-top: 8rpx;
  color: #9aa6b7;
  font-size: 19rpx;
  line-height: 1.4;
}
